import React, { useState, useRef } from 'react';
import { 
  UploadCloud, 
  FileText, 
  CheckCircle2, 
  Sparkles, 
  Download, 
  Trash2, 
  Search, 
  Filter, 
  Layers, 
  DollarSign, 
  RefreshCw 
} from 'lucide-react';

const CATEGORIES = ['All', 'Produce', 'Proteins', 'Dairy', 'Pantry & Dry Goods', 'Beverages', 'Packaging'];

export default function CatalogScannerLanding() {
  const [file, setFile] = useState(null);
  const [previewUrl, setPreviewUrl] = useState(null);
  const [loading, setLoading] = useState(false);
  const [selectedCategory, setSelectedCategory] = useState('All');
  const [searchQuery, setSearchQuery] = useState('');
  const [supplier, setSupplier] = useState('Generic Supplier');
  const [currency, setCurrency] = useState('ZAR');
  const [items, setItems] = useState([
    { id: '1', item_name: 'Roma Tomatoes Grade 1', category: 'Produce', pack_size: '5kg Box', price: 95.00, currency: 'ZAR', confidence_score: 0.98 },
    { id: '2', item_name: 'Fresh Full Cream Milk', category: 'Dairy', pack_size: '6 x 2L', price: 165.50, currency: 'ZAR', confidence_score: 0.95 },
    { id: '3', item_name: 'Prime Beef Chuck Cut', category: 'Proteins', pack_size: '1kg', price: 112.00, currency: 'ZAR', confidence_score: 0.92 },
    { id: '4', item_name: 'Long Grain Parboiled Rice', category: 'Pantry & Dry Goods', pack_size: '10kg Bag', price: 185.00, currency: 'ZAR', confidence_score: 0.99 },
    { id: '5', item_name: 'Pure Sunflower Cooking Oil', category: 'Pantry & Dry Goods', pack_size: '20L Drum', price: 540.00, currency: 'ZAR', confidence_score: 0.94 }
  ]);

  const fileInputRef = useRef(null);

  const handleFileChange = (e) => {
    const selected = e.target.files?.[0];
    if (selected) {
      setFile(selected);
      setPreviewUrl(URL.createObjectURL(selected));
    }
  };

  const handleScanUpload = async () => {
    if (!file) return;
    setLoading(true);

    const formData = new FormData();
    formData.append('file', file);

    try {
      const response = await fetch('http://localhost:8000/api/scan-catalog', {
        method: 'POST',
        body: formData,
      });

      if (!response.ok) throw new Error('Failed to scan catalog');

      const data = await response.json();
      if (data.supplier_name) setSupplier(data.supplier_name);
      if (data.currency) setCurrency(data.currency);

      const mappedItems = data.items.map((item, idx) => ({
        ...item,
        id: `scanned-${Date.now()}-${idx}`
      }));

      setItems(mappedItems);
    } catch (err) {
      console.error(err);
      alert('Scanning failed. Make sure backend is running.');
    } finally {
      setLoading(false);
    }
  };

  const updateItem = (id, field, value) => {
    setItems(items.map(item => item.id === id ? { ...item, [field]: value } : item));
  };

  const removeItem = (id) => {
    setItems(items.filter(item => item.id !== id));
  };

  const exportCSV = () => {
    const headers = ['Item Name,Category,Pack Size,Price,Currency,Confidence\n'];
    const rows = items.map(i => `"${i.item_name}","${i.category}","${i.pack_size}",${i.price},"${i.currency}",${i.confidence_score}\n`);
    const blob = new Blob([...headers, ...rows], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `catalog-extracted-${Date.now()}.csv`;
    a.click();
  };

  const filteredItems = items.filter(item => {
    const matchesCategory = selectedCategory === 'All' || item.category === selectedCategory;
    const matchesSearch = item.item_name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                          item.pack_size.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesCategory && matchesSearch;
  });

  const totalBasketValue = items.reduce((sum, item) => sum + Number(item.price || 0), 0);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 p-6 md:p-10 font-sans">
      <div className="max-w-7xl mx-auto space-y-8">
        
        {/* Header */}
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
          <div>
            <div className="flex items-center gap-2 text-emerald-400 font-semibold tracking-wide text-xs uppercase mb-1">
              <Sparkles className="w-4 h-4" /> AI Multimodal Vision Parser
            </div>
            <h1 className="text-3xl font-bold text-white tracking-tight">Food Catalog & Price Sheet Scanner</h1>
            <p className="text-slate-400 text-sm mt-1">Upload supplier catalogs, price lists, or delivery slips to automatically extract and structure SKU data.</p>
          </div>
          <button 
            onClick={exportCSV}
            className="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2.5 rounded-lg font-medium shadow-lg transition"
          >
            <Download className="w-4 h-4" /> Export CSV / ERP
          </button>
        </div>

        {/* Upload & Summary Grid */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          {/* Dropzone */}
          <div className="lg:col-span-2 bg-slate-900 border-2 border-dashed border-slate-800 hover:border-slate-700 rounded-xl p-8 flex flex-col items-center justify-center text-center relative overflow-hidden transition">
            <input 
              type="file" 
              ref={fileInputRef} 
              onChange={handleFileChange} 
              accept="image/*,application/pdf" 
              className="hidden" 
            />
            {previewUrl ? (
              <div className="w-full flex flex-col items-center space-y-4">
                <img src={previewUrl} alt="Catalog preview" className="h-44 object-contain rounded-lg border border-slate-800 bg-slate-950 p-2" />
                <div className="flex items-center gap-3">
                  <span className="text-sm font-medium text-slate-300">{file?.name}</span>
                  <button 
                    onClick={handleScanUpload} 
                    disabled={loading}
                    className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm px-4 py-2 rounded-lg font-semibold shadow disabled:opacity-50"
                  >
                    {loading ? <RefreshCw className="w-4 h-4 animate-spin" /> : <Sparkles className="w-4 h-4" />}
                    {loading ? 'Analyzing with Vision...' : 'Process Catalog'}
                  </button>
                </div>
              </div>
            ) : (
              <div className="space-y-4">
                <div className="w-14 h-14 bg-slate-800 text-emerald-400 rounded-full flex items-center justify-center mx-auto shadow-inner">
                  <UploadCloud className="w-7 h-7" />
                </div>
                <div>
                  <p className="font-semibold text-slate-200">Click to upload or drag catalog scan</p>
                  <p className="text-xs text-slate-500 mt-1">Accepts PNG, JPG, WebP, or PDF supplier catalogs</p>
                </div>
                <button 
                  onClick={() => fileInputRef.current?.click()} 
                  className="bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm px-4 py-2 rounded-lg font-medium transition"
                >
                  Select File
                </button>
              </div>
            )}
          </div>

          {/* Realtime KPI Cards */}
          <div className="flex flex-col gap-4">
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <div className="flex items-center justify-between text-slate-400 mb-2">
                <span className="text-xs uppercase font-semibold">Supplier Identified</span>
                <FileText className="w-4 h-4 text-indigo-400" />
              </div>
              <p className="text-xl font-bold text-white">{supplier}</p>
            </div>

            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <div className="flex items-center justify-between text-slate-400 mb-2">
                <span className="text-xs uppercase font-semibold">Total SKUs Parsed</span>
                <Layers className="w-4 h-4 text-emerald-400" />
              </div>
              <p className="text-2xl font-bold text-emerald-400">{items.length} Items</p>
            </div>

            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <div className="flex items-center justify-between text-slate-400 mb-2">
                <span className="text-xs uppercase font-semibold">Catalog Basket Sum</span>
                <DollarSign className="w-4 h-4 text-amber-400" />
              </div>
              <p className="text-2xl font-bold text-amber-400">{currency} {totalBasketValue.toFixed(2)}</p>
            </div>
          </div>

        </div>

        {/* Filter Controls & Search */}
        <div className="space-y-4">
          <div className="flex flex-col md:flex-row gap-4 items-center justify-between">
            <div className="flex flex-wrap gap-2 w-full md:w-auto">
              {CATEGORIES.map(cat => (
                <button
                  key={cat}
                  onClick={() => setSelectedCategory(cat)}
                  className={`text-xs px-3.5 py-2 rounded-lg font-medium transition ${
                    selectedCategory === cat 
                      ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' 
                      : 'bg-slate-900 text-slate-400 hover:text-slate-200 border border-slate-800'
                  }`}
                >
                  {cat}
                </button>
              ))}
            </div>

            <div className="relative w-full md:w-72">
              <Search className="w-4 h-4 absolute left-3 top-3 text-slate-500" />
              <input
                type="text"
                placeholder="Search items or pack sizes..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full bg-slate-900 border border-slate-800 rounded-lg pl-9 pr-4 py-2 text-sm text-slate-200 focus:outline-none focus:border-emerald-500 transition"
              />
            </div>
          </div>

          {/* Extracted Items Data Table */}
          <div className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
            <div className="overflow-x-auto">
              <table className="w-full text-left text-sm text-slate-300">
                <thead className="bg-slate-950/70 text-slate-400 text-xs uppercase font-semibold border-b border-slate-800">
                  <tr>
                    <th className="px-6 py-4">Item Description</th>
                    <th className="px-6 py-4">Category</th>
                    <th className="px-6 py-4">Pack Size</th>
                    <th className="px-6 py-4">Price ({currency})</th>
                    <th className="px-6 py-4 text-center">Confidence</th>
                    <th className="px-6 py-4 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800">
                  {filteredItems.map(item => (
                    <tr key={item.id} className="hover:bg-slate-800/40 transition">
                      <td className="px-6 py-4 font-medium text-slate-100">
                        <input
                          type="text"
                          value={item.item_name}
                          onChange={(e) => updateItem(item.id, 'item_name', e.target.value)}
                          className="bg-transparent border-b border-transparent hover:border-slate-600 focus:border-emerald-500 focus:outline-none w-full"
                        />
                      </td>
                      <td className="px-6 py-4">
                        <span className="inline-block px-2.5 py-1 text-xs rounded-md bg-slate-800 text-slate-300 border border-slate-700 font-medium">
                          {item.category}
                        </span>
                      </td>
                      <td className="px-6 py-4">
                        <input
                          type="text"
                          value={item.pack_size}
                          onChange={(e) => updateItem(item.id, 'pack_size', e.target.value)}
                          className="bg-transparent border-b border-transparent hover:border-slate-600 focus:border-emerald-500 focus:outline-none w-28"
                        />
                      </td>
                      <td className="px-6 py-4 font-semibold text-emerald-400">
                        <input
                          type="number"
                          step="0.01"
                          value={item.price}
                          onChange={(e) => updateItem(item.id, 'price', parseFloat(e.target.value) || 0)}
                          className="bg-transparent border-b border-transparent hover:border-slate-600 focus:border-emerald-500 focus:outline-none w-24 text-emerald-400 font-semibold"
                        />
                      </td>
                      <td className="px-6 py-4 text-center">
                        <span className="text-xs text-slate-400 font-mono">
                          {Math.round((item.confidence_score || 0.9) * 100)}%
                        </span>
                      </td>
                      <td className="px-6 py-4 text-right">
                        <button
                          onClick={() => removeItem(item.id)}
                          className="p-1 text-slate-500 hover:text-rose-400 transition"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </td>
                    </tr>
                  ))}
                  {filteredItems.length === 0 && (
                    <tr>
                      <td colSpan={6} className="text-center py-10 text-slate-500">
                        No items match the current filter or search criteria.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  );
}
